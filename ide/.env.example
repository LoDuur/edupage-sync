# Server
PORT=8787
# sha256 hex of the class access code (uppercase, trimmed). Generate: printf %s CODE | shasum -a 256
ACCESS_HASH=
# AUTH=off disables the access code entirely. Local development only.
# AUTH=off
# Set TRUST_PROXY=1 behind nginx/Caddy so per-device limits use X-Forwarded-For.
# TRUST_PROXY=1

# Storage – SQLite file for projects and version history (created on first start).
# DATABASE_PATH=./data/28teh.db

# Code execution
# auto (default): use bubblewrap when it is installed and works, otherwise execution is disabled.
# off: run code WITHOUT isolation – only for local development on your own machine.
# SANDBOX=auto
IDLE_MINUTES=10
MAX_PER_IP=2
MAX_TOTAL=20
# Processes allowed for the server's user inside a sandbox (counts all sandboxes together).
# MAX_PROCESSES=256
# Where per-terminal working directories live (wiped on start).
# RUN_DIR=/var/lib/28teh/sessions

# AI providers – a model appears in the assistant only when its provider key is set.
OPENROUTER_KEY=
GEMINI_API_KEY=
