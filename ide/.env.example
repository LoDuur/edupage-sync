# Server
PORT=8787
# sha256 hex of the class access code (uppercase, trimmed). Generate: echo -n CODE | shasum -a 256
ACCESS_HASH=
# Set AUTH=off ONLY for local development – it disables the access gate entirely.
# AUTH=off
# Set TRUST_PROXY=1 when running behind nginx/Caddy so per-IP limits use X-Forwarded-For.
# TRUST_PROXY=1

# AI providers – a model row appears in the selector only when its provider key is present.
OPENROUTER_KEY=
GEMINI_API_KEY=

# Sandbox
SANDBOX_IMAGE=28teh-sandbox
IDLE_MINUTES=10
MAX_PER_IP=2
MAX_TOTAL=20
# Docker connection (default: /var/run/docker.sock, or //./pipe/docker_engine on Windows)
# DOCKER_HOST=npipe:////./pipe/docker_engine
# DOCKER_HOST=tcp://127.0.0.1:2375
