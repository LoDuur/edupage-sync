{
  "name": "28teh",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "scripts": {
    "dev": "SANDBOX=${SANDBOX:-off} AUTH=${AUTH:-off} node --watch server.js",
    "start": "node server.js",
    "build": "bash tools/build-pil.sh",
    "test": "node --test test/*.test.js",
    "check": "node --check server.js && for f in lib/*.js lib/ai/*.js public/js/*.js; do node --check $f || exit 1; done && bash -n bin/compiler",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^4.21.2",
    "monaco-editor": "^0.57.0",
    "node-pty": "^1.1.0",
    "socket.io": "^4.8.3"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  },
  "engines": {
    "node": ">=22.13"
  }
}
